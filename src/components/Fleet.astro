---
import { getLangFromUrl, useTranslations, asset } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const vehicles = [
  {
    name: t('fleet.vehicle1.name'),
    category: t('fleet.vehicle1.category'),
    description: t('fleet.vehicle1.description'),
    price: t('fleet.vehicle1.price'),
    seats: t('fleet.vehicle1.seats'),
    transmission: t('fleet.vehicle1.transmission'),
    fuel: t('fleet.vehicle1.fuel'),
    drive: t('fleet.vehicle1.drive'),
    image: asset('/images/vehicle-land-cruiser.svg'),
    popular: true,
  },
  {
    name: t('fleet.vehicle2.name'),
    category: t('fleet.vehicle2.category'),
    description: t('fleet.vehicle2.description'),
    price: t('fleet.vehicle2.price'),
    seats: t('fleet.vehicle2.seats'),
    transmission: t('fleet.vehicle2.transmission'),
    fuel: t('fleet.vehicle2.fuel'),
    drive: t('fleet.vehicle2.drive'),
    image: asset('/images/vehicle-prado.svg'),
    popular: false,
  },
  {
    name: t('fleet.vehicle3.name'),
    category: t('fleet.vehicle3.category'),
    description: t('fleet.vehicle3.description'),
    price: t('fleet.vehicle3.price'),
    seats: t('fleet.vehicle3.seats'),
    transmission: t('fleet.vehicle3.transmission'),
    fuel: t('fleet.vehicle3.fuel'),
    drive: t('fleet.vehicle3.drive'),
    image: asset('/images/vehicle-hilux.svg'),
    popular: false,
  },
  {
    name: t('fleet.vehicle4.name'),
    category: t('fleet.vehicle4.category'),
    description: t('fleet.vehicle4.description'),
    price: t('fleet.vehicle4.price'),
    seats: t('fleet.vehicle4.seats'),
    transmission: t('fleet.vehicle4.transmission'),
    fuel: t('fleet.vehicle4.fuel'),
    drive: t('fleet.vehicle4.drive'),
    image: asset('/images/vehicle-rav4.svg'),
    popular: false,
  },
  {
    name: t('fleet.vehicle5.name'),
    category: t('fleet.vehicle5.category'),
    description: t('fleet.vehicle5.description'),
    price: t('fleet.vehicle5.price'),
    seats: t('fleet.vehicle5.seats'),
    transmission: t('fleet.vehicle5.transmission'),
    fuel: t('fleet.vehicle5.fuel'),
    drive: t('fleet.vehicle5.drive'),
    image: asset('/images/vehicle-defender.svg'),
    popular: false,
  },
  {
    name: t('fleet.vehicle6.name'),
    category: t('fleet.vehicle6.category'),
    description: t('fleet.vehicle6.description'),
    price: t('fleet.vehicle6.price'),
    seats: t('fleet.vehicle6.seats'),
    transmission: t('fleet.vehicle6.transmission'),
    fuel: t('fleet.vehicle6.fuel'),
    drive: t('fleet.vehicle6.drive'),
    image: asset('/images/vehicle-safari-van.svg'),
    popular: false,
  },
];
---

<section id="fleet" class="py-20 lg:py-28 bg-earth-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block text-brand-600 font-semibold text-sm uppercase tracking-widest mb-3">{t('fleet.title')}</span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">{t('fleet.subtitle')}</h2>
      <div class="w-20 h-1 bg-brand-500 mx-auto rounded-full"></div>
    </div>

    <!-- Vehicle Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {vehicles.map((vehicle, i) => (
        <div class={`group relative bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1 ${vehicle.popular ? 'ring-2 ring-brand-500' : ''}`}>
          {vehicle.popular && (
            <div class="absolute top-4 right-4 z-10 bg-brand-500 text-white text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wider">
              {lang === 'es' ? 'Popular' : 'Popular'}
            </div>
          )}

          <!-- Image -->
          <div class="relative h-52 overflow-hidden bg-gradient-to-br from-earth-100 to-earth-200">
            <img
              src={vehicle.image}
              alt={vehicle.name}
              class="w-full h-full object-contain p-4 group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
          </div>

          <!-- Content -->
          <div class="p-6">
            <div class="flex items-start justify-between gap-3 mb-3">
              <div>
                <span class="text-xs font-semibold text-brand-600 uppercase tracking-wider">{vehicle.category}</span>
                <h3 class="text-xl font-bold text-gray-900 mt-1">{vehicle.name}</h3>
              </div>
              <div class="text-right shrink-0">
                <span class="text-2xl font-display font-black text-brand-600">{vehicle.price}</span>
                <span class="block text-xs text-gray-500">/{t('fleet.perDay')}</span>
              </div>
            </div>

            <p class="text-gray-600 text-sm mb-4 leading-relaxed">{vehicle.description}</p>

            <!-- Specs -->
            <div class="grid grid-cols-2 gap-2 mb-5">
              <div class="flex items-center gap-2 text-xs text-gray-500">
                <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
                {vehicle.seats}
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-500">
                <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="3"/><path d="M12 1v2m0 18v2m-9-11h2m18 0h2m-4.22-5.78l-1.42 1.42M6.34 17.66l-1.42 1.42m0-12.73l1.42 1.42m11.32 11.31l1.42 1.42"/>
                </svg>
                {vehicle.transmission}
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-500">
                <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path d="M3 7v4a1 1 0 0 0 1 1h3l2 7h4l2-7h3a1 1 0 0 0 1-1V7"/>
                  <rect x="2" y="3" width="20" height="4" rx="1"/>
                </svg>
                {vehicle.fuel}
              </div>
              <div class="flex items-center gap-2 text-xs text-gray-500">
                <svg class="w-4 h-4 text-brand-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
                </svg>
                {vehicle.drive}
              </div>
            </div>

            <!-- CTA -->
            <a
              href={`https://wa.me/254700000000?text=${encodeURIComponent(`${t('general.whatsappMessage')} - ${vehicle.name}`)}`}
              target="_blank"
              rel="noopener"
              class="block w-full text-center bg-brand-500 hover:bg-brand-600 text-white font-semibold py-3 rounded-xl transition-all hover:shadow-lg hover:shadow-brand-500/25"
            >
              {t('general.bookNow')}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
