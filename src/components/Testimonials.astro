---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const reviews = [
  {
    text: t('testimonials.review1.text'),
    author: t('testimonials.review1.author'),
    country: t('testimonials.review1.country'),
    initials: 'HM',
    color: 'bg-brand-500',
    stars: 5,
  },
  {
    text: t('testimonials.review2.text'),
    author: t('testimonials.review2.author'),
    country: t('testimonials.review2.country'),
    initials: 'CR',
    color: 'bg-safari-600',
    stars: 5,
  },
  {
    text: t('testimonials.review3.text'),
    author: t('testimonials.review3.author'),
    country: t('testimonials.review3.country'),
    initials: 'JW',
    color: 'bg-earth-600',
    stars: 5,
  },
];
---

<section class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block text-brand-600 font-semibold text-sm uppercase tracking-widest mb-3">{t('testimonials.title')}</span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">{t('testimonials.subtitle')}</h2>
      <div class="w-20 h-1 bg-brand-500 mx-auto rounded-full"></div>
    </div>

    <!-- Reviews Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {reviews.map((review) => (
        <div class="bg-earth-50 rounded-2xl p-8 relative">
          <!-- Quote icon -->
          <svg class="absolute top-6 right-6 w-10 h-10 text-brand-200" fill="currentColor" viewBox="0 0 24 24">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10H14.017zM0 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151C7.546 6.068 5.983 8.789 5.983 11H10v10H0z"/>
          </svg>

          <!-- Stars -->
          <div class="flex gap-0.5 mb-4">
            {Array.from({length: review.stars}).map(() => (
              <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
            ))}
          </div>

          <!-- Text -->
          <p class="text-gray-700 leading-relaxed mb-6 italic">"{review.text}"</p>

          <!-- Author -->
          <div class="flex items-center gap-3">
            <div class={`w-12 h-12 ${review.color} rounded-full flex items-center justify-center text-white font-bold text-sm`}>
              {review.initials}
            </div>
            <div>
              <div class="font-bold text-gray-900">{review.author}</div>
              <div class="text-sm text-gray-500">{review.country}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Google Reviews CTA -->
    <div class="text-center mt-12">
      <div class="inline-flex items-center gap-3 bg-earth-50 rounded-full px-6 py-3">
        <svg class="w-6 h-6" viewBox="0 0 24 24">
          <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/>
          <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <span class="text-gray-600 text-sm font-medium">
          {lang === 'es' ? 'Valoración 5.0 en Google Reviews' : '5.0 rating on Google Reviews'}
        </span>
        <div class="flex gap-0.5">
          {[1,2,3,4,5].map(() => (
            <svg class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
