---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block text-brand-600 font-semibold text-sm uppercase tracking-widest mb-3">{t('contact.title')}</span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">{t('contact.subtitle')}</h2>
      <div class="w-20 h-1 bg-brand-500 mx-auto rounded-full"></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Contact Info -->
      <div>
        <div class="space-y-6 mb-10">
          <!-- WhatsApp -->
          <a
            href="https://wa.me/254700000000?text={encodeURIComponent(t('general.whatsappMessage'))}"
            target="_blank"
            rel="noopener"
            class="flex items-start gap-4 p-5 bg-green-50 rounded-xl hover:bg-green-100 transition-colors group"
          >
            <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 0 0 .611.611l4.458-1.495A11.952 11.952 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/>
              </svg>
            </div>
            <div>
              <div class="font-bold text-gray-900">{t('contact.whatsapp')}</div>
              <div class="text-green-700 text-sm">+254 700 000 000</div>
              <div class="text-gray-500 text-sm mt-1">{t('contact.whatsappDesc')}</div>
            </div>
          </a>

          <!-- Email -->
          <a href="mailto:info@keniasafarirentals.com" class="flex items-start gap-4 p-5 bg-earth-50 rounded-xl hover:bg-earth-100 transition-colors group">
            <div class="w-12 h-12 bg-brand-500 rounded-full flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <div class="font-bold text-gray-900">{t('contact.email')}</div>
              <div class="text-brand-600 text-sm">info@keniasafarirentals.com</div>
              <div class="text-gray-500 text-sm mt-1">{t('contact.emailDesc')}</div>
            </div>
          </a>

          <!-- Phone -->
          <a href="tel:+254700000000" class="flex items-start gap-4 p-5 bg-earth-50 rounded-xl hover:bg-earth-100 transition-colors group">
            <div class="w-12 h-12 bg-earth-600 rounded-full flex items-center justify-center shrink-0 group-hover:scale-110 transition-transform">
              <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </div>
            <div>
              <div class="font-bold text-gray-900">{t('contact.phone')}</div>
              <div class="text-earth-700 text-sm">+254 700 000 000</div>
              <div class="text-gray-500 text-sm mt-1">{t('contact.phoneDesc')}</div>
            </div>
          </a>
        </div>

        <!-- Location -->
        <div class="bg-earth-50 rounded-xl p-5">
          <div class="flex items-center gap-2 mb-2">
            <svg class="w-5 h-5 text-brand-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            <span class="font-bold text-gray-900">{t('contact.location')}</span>
          </div>
          <p class="text-gray-600 text-sm">Nairobi, Kenya</p>
          <p class="text-gray-500 text-xs mt-1">{lang === 'es' ? 'Entrega en cualquier punto de Kenia' : 'Delivery anywhere in Kenya'}</p>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="bg-earth-50 rounded-2xl p-8">
        <form id="contact-form" class="space-y-5">
          <div>
            <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">{t('contact.form.name')}</label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all outline-none"
              placeholder={lang === 'es' ? 'Tu nombre completo' : 'Your full name'}
            />
          </div>

          <div>
            <label for="dates" class="block text-sm font-semibold text-gray-700 mb-2">{t('contact.form.dates')}</label>
            <input
              type="text"
              id="dates"
              name="dates"
              required
              class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all outline-none"
              placeholder={lang === 'es' ? 'Ej: 15 Mar - 25 Mar 2026' : 'E.g.: 15 Mar - 25 Mar 2026'}
            />
          </div>

          <div>
            <label for="vehicle" class="block text-sm font-semibold text-gray-700 mb-2">{t('contact.form.vehicle')}</label>
            <select
              id="vehicle"
              name="vehicle"
              class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all outline-none"
            >
              <option value="">{lang === 'es' ? 'Selecciona un vehículo' : 'Select a vehicle'}</option>
              <option value="land-cruiser-70">Toyota Land Cruiser 70 Series</option>
              <option value="prado">Toyota Land Cruiser Prado</option>
              <option value="hilux">Toyota Hilux Double Cab</option>
              <option value="rav4">Toyota RAV4</option>
              <option value="defender">Land Rover Defender</option>
              <option value="safari-van">Safari Van</option>
            </select>
          </div>

          <div>
            <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">{t('contact.form.message')}</label>
            <textarea
              id="message"
              name="message"
              rows="4"
              class="w-full px-4 py-3 bg-white border border-gray-200 rounded-xl focus:ring-2 focus:ring-brand-500 focus:border-brand-500 transition-all outline-none resize-none"
              placeholder={lang === 'es' ? 'Cuéntanos sobre tu viaje...' : 'Tell us about your trip...'}
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full bg-brand-500 hover:bg-brand-600 text-white font-bold py-4 rounded-xl transition-all hover:shadow-lg hover:shadow-brand-500/25 hover:-translate-y-0.5"
          >
            {t('contact.form.submit')}
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const name = formData.get('name');
    const dates = formData.get('dates');
    const vehicle = formData.get('vehicle');
    const message = formData.get('message');

    const whatsappMsg = `Hola! Soy ${name}. Me interesa alquilar un ${vehicle || 'vehículo'} para las fechas ${dates}. ${message || ''}`.trim();
    window.open(`https://wa.me/254700000000?text=${encodeURIComponent(whatsappMsg)}`, '_blank');
  });
</script>
