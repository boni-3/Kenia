---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const reasons = [
  {
    title: t('whyUs.reason1.title'),
    description: t('whyUs.reason1.description'),
    icon: `<path d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
  },
  {
    title: t('whyUs.reason2.title'),
    description: t('whyUs.reason2.description'),
    icon: `<path d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
  },
  {
    title: t('whyUs.reason3.title'),
    description: t('whyUs.reason3.description'),
    icon: `<path d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
  },
  {
    title: t('whyUs.reason4.title'),
    description: t('whyUs.reason4.description'),
    icon: `<path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>`,
  },
  {
    title: t('whyUs.reason5.title'),
    description: t('whyUs.reason5.description'),
    icon: `<path d="M9 14l6-6m-5.5.5h.01m4.99 5h.01M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16l3.5-2 3.5 2 3.5-2 3.5 2zM10 8.5a.5.5 0 11-1 0 .5.5 0 011 0zm5 5a.5.5 0 11-1 0 .5.5 0 011 0z"/>`,
  },
  {
    title: t('whyUs.reason6.title'),
    description: t('whyUs.reason6.description'),
    icon: `<path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>`,
  },
];
---

<section id="why-us" class="py-20 lg:py-28 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block text-brand-600 font-semibold text-sm uppercase tracking-widest mb-3">{t('whyUs.title')}</span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">{t('whyUs.subtitle')}</h2>
      <div class="w-20 h-1 bg-brand-500 mx-auto rounded-full"></div>
    </div>

    <!-- Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {reasons.map((reason, i) => (
        <div class="group relative p-8 rounded-2xl bg-earth-50 hover:bg-white border border-transparent hover:border-brand-200 hover:shadow-xl transition-all duration-300">
          <div class="w-14 h-14 bg-brand-100 rounded-xl flex items-center justify-center mb-5 group-hover:bg-brand-500 transition-colors">
            <svg class="w-7 h-7 text-brand-600 group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <Fragment set:html={reason.icon} />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">{reason.title}</h3>
          <p class="text-gray-600 leading-relaxed">{reason.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
