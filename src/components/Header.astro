---
import { getLangFromUrl, useTranslations, getAlternateLang, getLocalizedPath, asset } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altLang = getAlternateLang(lang);
const altLangLabel = altLang === 'en' ? 'English' : 'Español';
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href={getLocalizedPath(lang, '/')} class="flex items-center gap-3 group">
        <img src={asset('/images/logo-placeholder.svg')} alt="Safari Rentals Kenya" class="h-10 w-auto" />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8">
        <a href="#fleet" class="nav-link text-sm font-medium text-white/90 hover:text-white transition-colors">{t('nav.fleet')}</a>
        <a href="#why-us" class="nav-link text-sm font-medium text-white/90 hover:text-white transition-colors">{t('nav.whyUs')}</a>
        <a href="#destinations" class="nav-link text-sm font-medium text-white/90 hover:text-white transition-colors">{t('nav.destinations')}</a>
        <a href="#pricing" class="nav-link text-sm font-medium text-white/90 hover:text-white transition-colors">{t('nav.pricing')}</a>
        <a href="#faq" class="nav-link text-sm font-medium text-white/90 hover:text-white transition-colors">{t('nav.faq')}</a>
        <a href="#contact" class="nav-link text-sm font-medium text-white/90 hover:text-white transition-colors">{t('nav.contact')}</a>
      </nav>

      <!-- Right side: Lang + CTA -->
      <div class="hidden lg:flex items-center gap-4">
        <a
          href={getLocalizedPath(altLang, '/')}
          class="flex items-center gap-1.5 text-sm font-medium text-white/80 hover:text-white transition-colors px-3 py-1.5 rounded-full border border-white/20 hover:border-white/40"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/>
            <path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          {altLangLabel}
        </a>
        <a
          href="https://wa.me/254700000000?text={encodeURIComponent(t('general.whatsappMessage'))}"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 bg-green-500 hover:bg-green-600 text-white font-semibold text-sm px-5 py-2.5 rounded-full transition-all hover:shadow-lg hover:shadow-green-500/25 hover:-translate-y-0.5"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 0 0 .611.611l4.458-1.495A11.952 11.952 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75c-2.33 0-4.506-.67-6.354-1.826l-.456-.273-2.648.888.888-2.648-.273-.456A9.724 9.724 0 0 1 2.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/>
          </svg>
          {t('nav.bookNow')}
        </a>
      </div>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="lg:hidden p-2 text-white" aria-label="Menu">
        <svg class="w-6 h-6 menu-open" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg class="w-6 h-6 menu-close hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="lg:hidden hidden bg-brand-950/95 backdrop-blur-md border-t border-white/10">
    <div class="px-4 py-6 space-y-4">
      <a href="#fleet" class="mobile-nav-link block text-white/90 hover:text-white font-medium py-2">{t('nav.fleet')}</a>
      <a href="#why-us" class="mobile-nav-link block text-white/90 hover:text-white font-medium py-2">{t('nav.whyUs')}</a>
      <a href="#destinations" class="mobile-nav-link block text-white/90 hover:text-white font-medium py-2">{t('nav.destinations')}</a>
      <a href="#pricing" class="mobile-nav-link block text-white/90 hover:text-white font-medium py-2">{t('nav.pricing')}</a>
      <a href="#faq" class="mobile-nav-link block text-white/90 hover:text-white font-medium py-2">{t('nav.faq')}</a>
      <a href="#contact" class="mobile-nav-link block text-white/90 hover:text-white font-medium py-2">{t('nav.contact')}</a>
      <hr class="border-white/10" />
      <a href={getLocalizedPath(altLang, '/')} class="block text-white/70 hover:text-white py-2">
        🌐 {altLangLabel}
      </a>
      <a
        href="https://wa.me/254700000000?text={encodeURIComponent(t('general.whatsappMessage'))}"
        target="_blank"
        rel="noopener"
        class="block bg-green-500 text-white text-center font-semibold py-3 rounded-full mt-4"
      >
        {t('nav.bookNow')}
      </a>
    </div>
  </div>
</header>

<script>
  // Header scroll effect
  const header = document.getElementById('header');
  function updateHeader() {
    if (!header) return;
    if (window.scrollY > 50) {
      header.classList.remove('bg-transparent');
      header.classList.add('bg-brand-950/95', 'backdrop-blur-md', 'shadow-lg');
    } else {
      header.classList.add('bg-transparent');
      header.classList.remove('bg-brand-950/95', 'backdrop-blur-md', 'shadow-lg');
    }
  }
  window.addEventListener('scroll', updateHeader);
  updateHeader();

  // Mobile menu toggle
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = btn?.querySelector('.menu-open');
  const closeIcon = btn?.querySelector('.menu-close');

  btn?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
    openIcon?.classList.toggle('hidden');
    closeIcon?.classList.toggle('hidden');
  });

  // Close mobile menu on link click
  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', () => {
      menu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
    });
  });
</script>
