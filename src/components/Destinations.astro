---
import { getLangFromUrl, useTranslations, asset } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const destinations = [
  {
    name: t('destinations.dest1.name'),
    description: t('destinations.dest1.description'),
    image: asset('/images/dest-masai-mara.svg'),
    distance: lang === 'es' ? '270 km desde Nairobi' : '270 km from Nairobi',
    highlight: lang === 'es' ? 'Gran Migración' : 'Great Migration',
  },
  {
    name: t('destinations.dest2.name'),
    description: t('destinations.dest2.description'),
    image: asset('/images/dest-amboseli.svg'),
    distance: lang === 'es' ? '240 km desde Nairobi' : '240 km from Nairobi',
    highlight: lang === 'es' ? 'Vista del Kilimanjaro' : 'Kilimanjaro views',
  },
  {
    name: t('destinations.dest3.name'),
    description: t('destinations.dest3.description'),
    image: asset('/images/dest-tsavo.svg'),
    distance: lang === 'es' ? '330 km desde Nairobi' : '330 km from Nairobi',
    highlight: lang === 'es' ? 'Parque más grande' : 'Largest park',
  },
  {
    name: t('destinations.dest4.name'),
    description: t('destinations.dest4.description'),
    image: asset('/images/dest-nakuru.svg'),
    distance: lang === 'es' ? '160 km desde Nairobi' : '160 km from Nairobi',
    highlight: lang === 'es' ? 'Flamencos & rinocerontes' : 'Flamingos & rhinos',
  },
];
---

<section id="destinations" class="py-20 lg:py-28 bg-earth-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block text-brand-600 font-semibold text-sm uppercase tracking-widest mb-3">{t('destinations.title')}</span>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 mb-4">{t('destinations.subtitle')}</h2>
      <div class="w-20 h-1 bg-brand-500 mx-auto rounded-full"></div>
    </div>

    <!-- Destinations Grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {destinations.map((dest) => (
        <div class="group relative rounded-2xl overflow-hidden h-80 cursor-pointer">
          <!-- Background Image -->
          <img src={dest.image} alt={dest.name} class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700" loading="lazy" />

          <!-- Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-brand-950/90 via-brand-950/40 to-transparent"></div>

          <!-- Content -->
          <div class="absolute inset-0 p-6 flex flex-col justify-end">
            <span class="inline-flex items-center gap-1 text-brand-300 text-xs font-semibold mb-2 uppercase tracking-wider">
              <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              {dest.highlight}
            </span>
            <h3 class="text-2xl font-display font-bold text-white mb-1">{dest.name}</h3>
            <p class="text-white/70 text-sm mb-3 line-clamp-2">{dest.description}</p>
            <div class="flex items-center justify-between">
              <span class="text-white/50 text-xs flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
                {dest.distance}
              </span>
              <span class="text-brand-400 text-sm font-semibold opacity-0 group-hover:opacity-100 transition-opacity flex items-center gap-1">
                {t('destinations.exploreCta')}
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
