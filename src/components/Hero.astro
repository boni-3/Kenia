---
import { getLangFromUrl, useTranslations, asset } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="hero" class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background -->
  <div class="absolute inset-0">
    <img src={asset('/images/hero-bg.svg')} alt="" class="w-full h-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-b from-brand-950/70 via-brand-950/50 to-brand-950/80"></div>
  </div>

  <!-- Floating particles / atmosphere -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <div class="absolute top-1/4 left-1/4 w-2 h-2 bg-brand-400/30 rounded-full animate-pulse"></div>
    <div class="absolute top-1/3 right-1/3 w-1.5 h-1.5 bg-brand-300/20 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
    <div class="absolute bottom-1/3 left-1/3 w-2.5 h-2.5 bg-brand-400/20 rounded-full animate-pulse" style="animation-delay: 2s;"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-20">
    <!-- Trust badge -->
    <div class="animate-fade-in-up inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full px-5 py-2 mb-8">
      <div class="flex -space-x-1.5">
        <div class="w-6 h-6 rounded-full bg-brand-400 border-2 border-white/30 flex items-center justify-center text-[10px] text-white font-bold">M</div>
        <div class="w-6 h-6 rounded-full bg-safari-500 border-2 border-white/30 flex items-center justify-center text-[10px] text-white font-bold">K</div>
        <div class="w-6 h-6 rounded-full bg-earth-500 border-2 border-white/30 flex items-center justify-center text-[10px] text-white font-bold">J</div>
      </div>
      <span class="text-white/90 text-sm font-medium">{t('hero.badge')}</span>
      <div class="flex gap-0.5">
        {[1,2,3,4,5].map(() => (
          <svg class="w-3.5 h-3.5 text-yellow-400 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
        ))}
      </div>
    </div>

    <!-- Main Title -->
    <h1 class="animate-fade-in-up stagger-1 font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-white leading-tight mb-6 tracking-tight">
      {t('hero.title')}
    </h1>

    <!-- Subtitle -->
    <p class="animate-fade-in-up stagger-2 text-lg sm:text-xl md:text-2xl text-white/80 max-w-3xl mx-auto mb-10 leading-relaxed">
      {t('hero.subtitle')}
    </p>

    <!-- CTAs -->
    <div class="animate-fade-in-up stagger-3 flex flex-col sm:flex-row items-center justify-center gap-4 mb-16">
      <a
        href="https://wa.me/254700000000?text={encodeURIComponent(t('general.whatsappMessage'))}"
        target="_blank"
        rel="noopener"
        class="group inline-flex items-center gap-3 bg-green-500 hover:bg-green-600 text-white font-bold text-lg px-8 py-4 rounded-full transition-all hover:shadow-2xl hover:shadow-green-500/30 hover:-translate-y-1"
      >
        <svg class="w-6 h-6 group-hover:scale-110 transition-transform" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
          <path d="M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492a.5.5 0 0 0 .611.611l4.458-1.495A11.952 11.952 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.75c-2.33 0-4.506-.67-6.354-1.826l-.456-.273-2.648.888.888-2.648-.273-.456A9.724 9.724 0 0 1 2.25 12C2.25 6.615 6.615 2.25 12 2.25S21.75 6.615 21.75 12 17.385 21.75 12 21.75z"/>
        </svg>
        {t('hero.cta')}
      </a>
      <a
        href="#fleet"
        class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 backdrop-blur-sm text-white font-semibold text-lg px-8 py-4 rounded-full border border-white/20 hover:border-white/40 transition-all hover:-translate-y-0.5"
      >
        {t('hero.ctaSecondary')}
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M19 9l-7 7-7-7"/>
        </svg>
      </a>
    </div>

    <!-- Stats bar -->
    <div class="animate-fade-in-up stagger-4 grid grid-cols-2 md:grid-cols-4 gap-6 max-w-4xl mx-auto">
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-display font-black text-brand-400">500+</div>
        <div class="text-sm text-white/60 mt-1">{lang === 'es' ? 'Clientes satisfechos' : 'Happy customers'}</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-display font-black text-brand-400">15+</div>
        <div class="text-sm text-white/60 mt-1">{lang === 'es' ? 'Vehículos en flota' : 'Vehicles in fleet'}</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-display font-black text-brand-400">24/7</div>
        <div class="text-sm text-white/60 mt-1">{lang === 'es' ? 'Asistencia en ruta' : 'Roadside assistance'}</div>
      </div>
      <div class="text-center">
        <div class="text-3xl sm:text-4xl font-display font-black text-brand-400">5★</div>
        <div class="text-sm text-white/60 mt-1">Google Reviews</div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
    <svg class="w-6 h-6 text-white/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
    </svg>
  </div>
</section>
