---
import { getLangFromUrl, useTranslations, getAlternateLang, getLocalizedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const altLang = getAlternateLang(lang);
---

<footer class="bg-brand-950 text-white">
  <!-- Main Footer -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Brand -->
      <div class="sm:col-span-2 lg:col-span-1">
        <a href={getLocalizedPath(lang, '/')} class="inline-block mb-4">
          <img src="/images/logo-placeholder.svg" alt="Safari Rentals Kenya" class="h-10 w-auto brightness-0 invert" />
        </a>
        <p class="text-white/60 text-sm leading-relaxed mb-6">{t('footer.description')}</p>

        <!-- Social links -->
        <div class="flex gap-3">
          <a href="#" class="w-10 h-10 bg-white/10 hover:bg-brand-500 rounded-full flex items-center justify-center transition-colors" aria-label="Instagram">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 bg-white/10 hover:bg-brand-500 rounded-full flex items-center justify-center transition-colors" aria-label="Facebook">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="#" class="w-10 h-10 bg-white/10 hover:bg-brand-500 rounded-full flex items-center justify-center transition-colors" aria-label="TripAdvisor">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.006 4.295c-2.67 0-5.338.784-7.645 2.353H0l1.963 2.135a5.997 5.997 0 004.04 10.43 5.976 5.976 0 004.003-1.533l2 2.328 2-2.328a5.976 5.976 0 004.003 1.533 5.997 5.997 0 004.04-10.43L24 6.648h-4.35a13.573 13.573 0 00-7.644-2.353zM6.003 17.213a3.997 3.997 0 110-7.994 3.997 3.997 0 010 7.994zm11.994 0a3.997 3.997 0 110-7.994 3.997 3.997 0 010 7.994zM6.003 11.219a2 2 0 100 4 2 2 0 000-4zm11.994 0a2 2 0 100 4 2 2 0 000-4z"/></svg>
          </a>
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="font-bold text-white mb-4">{t('footer.quickLinks')}</h4>
        <ul class="space-y-3">
          <li><a href="#fleet" class="text-white/60 hover:text-brand-400 text-sm transition-colors">{t('nav.fleet')}</a></li>
          <li><a href="#why-us" class="text-white/60 hover:text-brand-400 text-sm transition-colors">{t('nav.whyUs')}</a></li>
          <li><a href="#destinations" class="text-white/60 hover:text-brand-400 text-sm transition-colors">{t('nav.destinations')}</a></li>
          <li><a href="#pricing" class="text-white/60 hover:text-brand-400 text-sm transition-colors">{t('nav.pricing')}</a></li>
          <li><a href="#faq" class="text-white/60 hover:text-brand-400 text-sm transition-colors">{t('nav.faq')}</a></li>
          <li><a href="#contact" class="text-white/60 hover:text-brand-400 text-sm transition-colors">{t('nav.contact')}</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <h4 class="font-bold text-white mb-4">{t('footer.legal')}</h4>
        <ul class="space-y-3">
          <li><a href="#" class="text-white/60 hover:text-brand-400 text-sm transition-colors">{t('footer.privacy')}</a></li>
          <li><a href="#" class="text-white/60 hover:text-brand-400 text-sm transition-colors">{t('footer.terms')}</a></li>
          <li><a href="#" class="text-white/60 hover:text-brand-400 text-sm transition-colors">{t('footer.cookies')}</a></li>
        </ul>
      </div>

      <!-- Language & Payment -->
      <div>
        <h4 class="font-bold text-white mb-4">{lang === 'es' ? 'Idioma' : 'Language'}</h4>
        <div class="flex gap-2 mb-8">
          <a
            href={getLocalizedPath('es', '/')}
            class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${lang === 'es' ? 'bg-brand-500 text-white' : 'bg-white/10 text-white/60 hover:bg-white/20'}`}
          >
            Español
          </a>
          <a
            href={getLocalizedPath('en', '/')}
            class={`px-4 py-2 rounded-lg text-sm font-medium transition-colors ${lang === 'en' ? 'bg-brand-500 text-white' : 'bg-white/10 text-white/60 hover:bg-white/20'}`}
          >
            English
          </a>
        </div>

        <h4 class="font-bold text-white mb-4">{t('footer.payments')}</h4>
        <div class="flex flex-wrap gap-3">
          <span class="px-3 py-1.5 bg-white/10 rounded-lg text-xs text-white/70 font-medium">M-Pesa</span>
          <span class="px-3 py-1.5 bg-white/10 rounded-lg text-xs text-white/70 font-medium">Visa</span>
          <span class="px-3 py-1.5 bg-white/10 rounded-lg text-xs text-white/70 font-medium">Mastercard</span>
          <span class="px-3 py-1.5 bg-white/10 rounded-lg text-xs text-white/70 font-medium">PayPal</span>
          <span class="px-3 py-1.5 bg-white/10 rounded-lg text-xs text-white/70 font-medium">Transfer</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-white/40 text-sm">{t('footer.copyright')}</p>
      <p class="text-white/30 text-xs">
        {lang === 'es' ? 'Diseñado con ❤️ para aventureros' : 'Designed with ❤️ for adventurers'}
      </p>
    </div>
  </div>
</footer>
