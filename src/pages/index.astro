---
import { asset } from '../i18n/utils';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Montserrat:wght@600;700;800;900&display=swap" rel="stylesheet" />
    <title>Safari Rentals Kenya | Choose Your Language</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Inter', system-ui, sans-serif;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1a0f08;
        overflow: hidden;
        position: relative;
      }

      .bg {
        position: absolute;
        inset: 0;
        z-index: 0;
      }

      .bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.35;
      }

      .bg::after {
        content: '';
        position: absolute;
        inset: 0;
        background: radial-gradient(ellipse at center, rgba(26,15,8,0.3) 0%, rgba(26,15,8,0.85) 100%);
      }

      .container {
        position: relative;
        z-index: 10;
        text-align: center;
        padding: 2rem;
        max-width: 540px;
        width: 100%;
        animation: fadeIn 0.8s ease-out;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
      }

      .logo {
        height: 50px;
        width: auto;
        margin-bottom: 2rem;
        filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));
      }

      h1 {
        font-family: 'Montserrat', system-ui, sans-serif;
        font-size: 1.5rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
      }

      .subtitle {
        color: rgba(255,255,255,0.55);
        font-size: 0.9rem;
        margin-bottom: 2.5rem;
        line-height: 1.5;
      }

      .lang-buttons {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        margin-bottom: 2rem;
      }

      .lang-btn {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 1.1rem 1.5rem;
        border-radius: 1rem;
        border: 1.5px solid rgba(255,255,255,0.12);
        background: rgba(255,255,255,0.05);
        backdrop-filter: blur(10px);
        color: #fff;
        text-decoration: none;
        transition: all 0.25s ease;
        cursor: pointer;
      }

      .lang-btn:hover {
        background: rgba(212,121,42,0.15);
        border-color: rgba(212,121,42,0.5);
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(212,121,42,0.15);
      }

      .flag {
        font-size: 2rem;
        line-height: 1;
        flex-shrink: 0;
      }

      .lang-info {
        text-align: left;
      }

      .lang-name {
        font-weight: 600;
        font-size: 1.05rem;
        margin-bottom: 0.15rem;
      }

      .lang-desc {
        font-size: 0.78rem;
        color: rgba(255,255,255,0.45);
      }

      .arrow {
        margin-left: auto;
        color: rgba(255,255,255,0.25);
        transition: all 0.25s ease;
        flex-shrink: 0;
      }

      .lang-btn:hover .arrow {
        color: #d4792a;
        transform: translateX(4px);
      }

      .trust {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: rgba(255,255,255,0.35);
        font-size: 0.75rem;
      }

      .trust svg {
        width: 14px;
        height: 14px;
        fill: #f5a623;
      }

      @media (min-width: 480px) {
        .lang-buttons {
          flex-direction: row;
        }
        .lang-btn {
          flex: 1;
          flex-direction: column;
          text-align: center;
          padding: 1.8rem 1.2rem;
        }
        .lang-info {
          text-align: center;
        }
        .arrow {
          margin-left: 0;
        }
      }
    </style>
  </head>
  <body>
    <div class="bg">
      <img src={asset('/images/hero-bg.svg')} alt="" />
    </div>

    <div class="container">
      <img src={asset('/images/logo-placeholder.svg')} alt="Safari Rentals Kenya" class="logo" />

      <h1>Welcome / Bienvenido</h1>
      <p class="subtitle">Choose your language to continue<br/>Elige tu idioma para continuar</p>

      <div class="lang-buttons">
        <a href={`${base}/es/`} class="lang-btn">
          <span class="flag">&#127466;&#127480;</span>
          <div class="lang-info">
            <div class="lang-name">Español</div>
            <div class="lang-desc">Continuar en español</div>
          </div>
          <svg class="arrow" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg>
        </a>

        <a href={`${base}/en/`} class="lang-btn">
          <span class="flag">&#127468;&#127463;</span>
          <div class="lang-info">
            <div class="lang-name">English</div>
            <div class="lang-desc">Continue in English</div>
          </div>
          <svg class="arrow" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M9 5l7 7-7 7"/></svg>
        </a>
      </div>

      <div class="trust">
        <svg viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
        500+ happy customers &bull; 4x4 Safari Vehicles &bull; Kenya
      </div>
    </div>

    <script define:vars={{ base }}>
      // Auto-detect browser language and remember choice
      const saved = localStorage.getItem('safari-rentals-lang');
      if (saved === 'es') window.location.href = base + '/es/';
      else if (saved === 'en') window.location.href = base + '/en/';

      // Save choice on click
      document.querySelectorAll('.lang-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          const href = btn.getAttribute('href');
          if (href.includes('/es/')) localStorage.setItem('safari-rentals-lang', 'es');
          else if (href.includes('/en/')) localStorage.setItem('safari-rentals-lang', 'en');
        });
      });
    </script>
  </body>
</html>
